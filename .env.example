# API (backend)
VITE_API_URL=
VITE_API_PROXY=http://localhost:8000

# Backend
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/srl.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost
BACKUP_DIR=./backups

# System Administrator login (change before production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SRLAdmin2026!
ADMIN_DISPLAY_NAME=System Administrator
ADMIN_SESSION_HOURS=24

# Docker / production
NGINX_PORT=80

# SRL Chat Assistant — AI-powered responses
# Set ONE of the following API keys in a .env file at the project root:

# OpenAI (recommended)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (alternative)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# Provider: auto | openai | gemini
CHAT_AI_PROVIDER=auto
